# Use forward slashes "/" in paths for compatibility across platforms

# Storage
# Directory for everything fetched: tracklists, audio, lyrics, cover art. A
# relative path resolves against the repo root, not the working directory.
SPOTIFIXED_CACHE_DIR="cache"

# Directory for hand-authored per-track values (timing offsets, audio pins).
# Kept apart from the cache so wiping the cache never loses a correction.
SPOTIFIXED_STATE_DIR="state"


# Tracklist (Apify)
# Apify API token. Environment only, never a CLI argument and never a committed
# file. Needed solely to fetch a playlist's track list that is not cached yet;
# see secrets.env.example for where the real value lives.
APIFY_TOKEN=""

# Apify Actor that returns a playlist's tracks, as user~name. The response shape
# is Actor-specific, so a new Actor also needs a parser.
SPOTIFIXED_TRACKLIST_ACTOR="s-r~free-spotify-playlist-intelligence"

# Charge cap sent with each Actor run, in US dollars.
SPOTIFIXED_APIFY_MAX_CHARGE_USD="0.05"

# Apify API origin. Tests point this at a local stub.
SPOTIFIXED_APIFY_BASE_URL="https://api.apify.com"


# Sync
# LRCLIB origin, the lyrics source.
SPOTIFIXED_LRCLIB_BASE_URL="https://lrclib.net"

# An audio candidate within this many seconds of Spotify's duration gets full
# marks for duration.
SPOTIFIXED_AUDIO_DURATION_TOLERANCE_S="3.0"

# An audio candidate further than this from Spotify's duration is rejected.
SPOTIFIXED_AUDIO_DURATION_REJECT_S="7.0"

# A lyrics record further than this from the audio's real duration is still
# kept, but flagged as low timing confidence.
SPOTIFIXED_LYRICS_DURATION_TOLERANCE_S="2.0"

# Tracks processed in parallel. Keep low to stay polite to the sources.
SPOTIFIXED_SYNC_WORKERS="2"

# A recorded miss (no lyrics, no audio match) is retried after this many days.
SPOTIFIXED_MISS_RETRY_DAYS="14"


# Daemon
# Address the daemon binds. Anything other than loopback is refused.
SPOTIFIXED_HOST="127.0.0.1"

# Port for the daemon's HTTP API and remote-control page.
SPOTIFIXED_PORT="8765"

# mpv executable.
SPOTIFIXED_MPV_BIN="mpv"

# mpv --ao value. Empty lets mpv choose; tests use `null` for silence.
SPOTIFIXED_MPV_AUDIO_OUTPUT=""

# Path to mpv's MPRIS plugin (Debian: /usr/lib/mpv-mpris/mpris.so) so desktop
# media keys control playback. Empty disables it.
SPOTIFIXED_MPV_MPRIS_PLUGIN=""


# Overlay
# Output connector to show the overlay on, e.g. DP-2. Empty: compositor's choice.
SPOTIFIXED_OVERLAY_MONITOR=""

# Screen edge or corner the overlay is attached to.
SPOTIFIXED_OVERLAY_ANCHOR="bottom"

# Horizontal distance in pixels from the anchored edge.
SPOTIFIXED_OVERLAY_MARGIN_X="0"

# Vertical distance in pixels from the anchored edge.
SPOTIFIXED_OVERLAY_MARGIN_Y="120"

# Maximum line width in pixels; longer lines wrap.
SPOTIFIXED_OVERLAY_MAX_WIDTH="1200"

# Font family and style.
SPOTIFIXED_OVERLAY_FONT="Sans Bold"

# Font size in points.
SPOTIFIXED_OVERLAY_FONT_SIZE="32"

# Text colour.
SPOTIFIXED_OVERLAY_COLOR="#FFFFFF"

# Outline colour, for contrast against any background.
SPOTIFIXED_OVERLAY_OUTLINE_COLOR="#000000"

# 1 shows the current line; 2 adds the next line, dimmed.
SPOTIFIXED_OVERLAY_LINES="1"

# Show each line this many milliseconds before its timestamp.
SPOTIFIXED_OVERLAY_LEAD_MS="150"

# Fade duration when a line appears or disappears.
SPOTIFIXED_OVERLAY_FADE_MS="120"

# Underline the word being sung, in the overlay and on the page. The word is
# estimated from the line timing, so it needs the track's offset to be right.
SPOTIFIXED_OVERLAY_UNDERLINE_WORD="False"

# Show spotifixed's volume in the overlay for a moment whenever it changes,
# above the lyric line, even while paused, and the level rising during the
# fade-in on resume.
SPOTIFIXED_OVERLAY_VOLUME_INDICATOR="True"


# Shortcuts
# Global shortcut that raises spotifixed's own volume, in the XDG shortcuts
# format (modifiers CTRL, ALT, SHIFT, NUM, LOGO joined by + to an xkb key name,
# e.g. CTRL+XF86AudioRaiseVolume or LOGO+Up). It is the trigger suggested to the
# desktop's global shortcuts portal, which may let the user change it. Empty
# disables it. Play, pause, next and previous are the keyboard's media keys
# (SPOTIFIXED_MPV_MPRIS_PLUGIN), not settings here.
SPOTIFIXED_SHORTCUT_VOLUME_UP="CTRL+XF86AudioRaiseVolume"

# Global shortcut that lowers spotifixed's own volume, in the same format as
# SPOTIFIXED_SHORTCUT_VOLUME_UP. Empty disables it.
SPOTIFIXED_SHORTCUT_VOLUME_DOWN="CTRL+XF86AudioLowerVolume"

# Global shortcut that skips the song that is on and turns it off, so it is not
# played again until it is turned back on in the page's track list. In the same
# format as SPOTIFIXED_SHORTCUT_VOLUME_UP. Empty disables it.
SPOTIFIXED_SHORTCUT_SKIP_DISABLE="LOGO+XF86AudioNext"

# How much one press of a volume shortcut changes the volume, out of 100.
SPOTIFIXED_SHORTCUT_VOLUME_STEP="5"
